# =============================================================================
# VELA — REALISTIC CAMPUS AI SOCIAL NETWORK — ENVIRONMENT & API KEYS
# =============================================================================

# 1. DATABASE (leave blank for embedded local PGlite with pgvector + uuid-ossp)
DATABASE_URL=

# 2. PRIMARY LLM PROVIDER (Free-first recommended: Google Gemini Free Tier!)
# Choose: "gemini" | "openai_compatible"
LLM_PROVIDER=gemini

# Option A: Google Gemini API (Free Tier: Chat + Vision + 768d Embeddings + 22-Voice Native TTS!)
GEMINI_API_KEY=
GEMINI_ROLEPLAY_MODEL=gemini-3-flash-preview
GEMINI_ROLEPLAY_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-flash-lite-latest
GEMINI_FAST_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Option B: Secondary Automatic Live Failover (e.g. Free NVIDIA NIM when Gemini hits 429/503)
FALLBACK_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Option C: Primary OpenAI-Compatible LLM (if LLM_PROVIDER=openai_compatible)
LLM_BASE_URL=
LLM_API_KEY=
LLM_ROLEPLAY_MODEL=nvidia/nemotron-3.5-bolt-e4b
LLM_FAST_MODEL=nvidia/nemotron-3.5-bolt-e4b
LLM_EMBEDDING_MODEL=

# 3. PHOTOREALISTIC IMAGE GENERATION (Feed Posts, Stories & DM Photos)
# Choose: "curated" ($0 watermark-free real campus photos) | "pollinations" ($0 FLUX, 1/45s) | "gemini" (requires billing) | "openai_compatible"
IMAGE_PROVIDER=curated
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_BASE_URL=
IMAGE_API_KEY=

# 4. REAL NEURAL VOICE NOTES (22 unique human voices — zero robotic browser TTS!)
# Choose: "gemini" (22 expressive voices + auto Edge Neural fallback!) | "edge_neural" (unlimited $0) | "elevenlabs" | "openai"
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts

# 5. OPTIONAL LIVE VIDEO NOTE WEBHOOK
MEDIA_VIDEO_ENDPOINT=

# 6. SIMULATION PACING (1 = realistic human campus timing, 5 = brisk testing mode)
SIMULATION_SPEED_MULTIPLIER=1
